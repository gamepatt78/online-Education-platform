# Environment Configuration for Online Education Platform

# Application Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Configure either DATABASE_URL or the individual PostgreSQL settings.
# Replace the placeholder credentials with values for your own database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/education_platform
PGHOST=localhost
PGPORT=5432
PGDATABASE=education_platform
PGUSER=USER
PGPASSWORD=PASSWORD

# Generate a random secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
